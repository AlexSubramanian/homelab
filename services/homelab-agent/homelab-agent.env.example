# Copy to /etc/homelab-agent/env, fill in, then: chmod 0600, chown root:root
#
# Generate a token with:  openssl rand -hex 32
HOMELAB_AGENT_TOKEN=<to-be-set>

# Listen on this host's LAN address only -- never 0.0.0.0, which would also
# expose the agent on any other interface the host happens to gain.
#   arr-stack  192.168.1.75
#   plex       192.168.1.103
#   monitoring 192.168.1.228
HOMELAB_AGENT_BIND=<this-host-lan-ip>
HOMELAB_AGENT_PORT=9180

# Normally auto-detected from the hostname; set it to override.
#HOMELAB_AGENT_SERVICE=arr-stack

# How often the background status refresh runs, in seconds. Defaults to 6h to
# match Diun's scan schedule.
#HOMELAB_AGENT_REFRESH_SECONDS=21600
