[Unit]
Description=Plex Media Server Docker Compose
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/docker/plex
# The compose file list is data, not a hardcoded -f flag, so update.sh can add a
# digest-pinned rollback overlay to COMPOSE_FILE without editing this unit.
# Passing -f explicitly would also disable Compose's override discovery.
# The leading - means a missing stack.env is survivable: COMPOSE_FILE is then
# unset and Compose discovers docker-compose.yml in WorkingDirectory as before.
EnvironmentFile=-/var/lib/homelab/plex/stack.env
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=on-failure
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
